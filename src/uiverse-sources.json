        "html": "<input placeholder=\"Username\" class=\"input\" name=\"text\" type=\"text\" />\n\n<style>\n/* From Uiverse.io by Cksunandh  - Tags: input, rounded, dark, message, border, html, css */\n.input {\n  margin: 30px;\n  background: none;\n  border: 1px solid #353535;\n  outline: none;\n  max-width: 200px;\n  padding: 11px 23px;\n  font-size: 16px;\n  border-radius: 50px;\n  color: #979797;\n  box-shadow: rgb(136 136 136 / 17%) 0px -23px 25px 0px inset,\n    rgb(81 81 81 / 23%) 0px -36px 30px 0px inset,\n    rgba(0, 0, 0, 0.1) 0px -79px 40px 0px inset, rgba(0, 0, 0, 0.06) 0px 2px 1px,\n    rgba(0, 0, 0, 0.09) 0px 4px 2px, rgba(0, 0, 0, 0.09) 0px 8px 4px,\n    rgba(0, 0, 0, 0.09) 0px 16px 8px, rgba(0, 0, 0, 0.09) 0px 32px 16px;\n}\n\n</style>\n    "
